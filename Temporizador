library IEEE 
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity temporizador is
   port(

      clk_1Hz :in std_logic;
      arranque :in std_logic;
      parada :in std_logic;
      reinicio :in std_logic;

      seg_uni :out std_logic_vector(6 downto 0);
      seg_dec :out std_logic_vector(6 downto 0);
      min out std_logic_vector(6 downto);
);
end component;

architecture behavioral of temporizador is

   component deco
     port(
        A:in integer range 0 to 9;
        d:out std_logic_vector(6 downto 0)
end component;

signal run: std_logic:='0';


signal unidades: integer range 0 to 9 :=0;
signal decenas: integer range 0 to 5 :=0;
signal minutos: integer range 0 to 9 :=0;


begin

proceso_control: process(clk_1)

begin 

  if rising_edge(clk_1Hz) then 

  if reinicio = '1' then

   run <='0';

  elsif arranque = '1' then

   run <='1';

  elsif parada='1' then

   run <='0';

  end if;

 end if;

end process;

display_minutos : deco

port map(

    A => minutos,
    d => min

);



display_decenas : deco

port map(

    A => decenas,
    d => seg_dec

);



display_unidades : deco

port map(

    A => unidades,
    d => seg_uni

);
