library IEEE;
use IEEE.std_logic_1164.all;
use.IEEE.numeric_std.all;

entity contador is
    port(
        clk_1Hz  : in  std_logic;
        arranque : in  std_logic;
        parada   : in  std_logic;
        reinicio : in  std_logic;

        unidades : out integer range 0 to 9;
        decenas  : out integer range 0 to 5;
        minutos  : out integer range 0 to 9
    );
end entity contador;


architecture behavioral of contador is

    signal run : std_logic := '0';

    signal unidades_int : integer range 0 to 9 := 0;
    signal decenas_int  : integer range 0 to 5 := 0;
    signal minutos_int  : integer range 0 to 9 := 0;

begin

    proceso_contador : process(clk_1Hz)
    begin

        if rising_edge(clk_1Hz) then

            -- REINICIO
            if reinicio = '1' then

                run          <= '0';
                unidades_int <= 0;
                decenas_int  <= 0;
                minutos_int  <= 0;

            -- ARRANQUE
            elsif arranque = '1' then

                run <= '1';

            -- PARADA
            elsif parada = '1' then

                run <= '0';

            -- CONTEO
            elsif run = '1' then

                -- Límite máximo: 09:59
                if (minutos_int = 9) and
                   (decenas_int = 5) and
                   (unidades_int = 9) then

                    run <= '0';

                -- Incrementar unidades
                elsif unidades_int < 9 then

                    unidades_int <= unidades_int + 1;

                -- Cuando unidades llega a 9
                else

                    unidades_int <= 0;

                    -- Incrementar decenas
                    if decenas_int < 5 then

                        decenas_int <= decenas_int + 1;

                    -- Cuando llegamos a 59 segundos
                    else

                        decenas_int <= 0;
                        minutos_int <= minutos_int + 1;

                    end if;

                end if;

            end if;

        end if;

    end process;


    -- Conexión de las señales internas con las salidas
    unidades <= unidades_int;
    decenas  <= decenas_int;
    minutos  <= minutos_int;

end architecture behavioral;

"en este archivo se encuentra el deco con sus modulos aginado como vhdl3/deco"

library IEEE;
use IEEE.std_logic_1164.all;
use IEEE.numeric_std.all;
entity deco is
    port(
        A : in  integer range 0 to 9;
        d : out std_logic_vector(6 downto 0)
    );
end entity deco;


architecture behavioral of deco is

begin

    process(A)
    begin

        case A is

            when 0 =>
                d <= "1000000";

            when 1 =>
                d <= "1111001";

            when 2 =>
                d <= "0100100";

            when 3 =>
                d <= "0110000";

            when 4 =>
                d <= "0011001";

            when 5 =>
                d <= "0010010";

            when 6 =>
                d <= "0000010";

            when 7 =>
                d <= "1111000";

            when 8 =>
                d <= "0000000";

            when 9 =>
                d <= "0010000";

            when others =>
                d <= "1111111";

        end case;

    end process;

end architecture behavioral;
