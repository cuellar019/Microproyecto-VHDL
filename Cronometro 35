library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity divisor_1s is

    port(
        clk      : in  std_logic;
        reset    : in  std_logic;
        pulso_1s : out std_logic
    );

end divisor_1s;


architecture behavioral of divisor_1s is

    signal contador : integer range 0 to 49999999 := 0;

begin

    process(clk)

    begin

        if rising_edge(clk) then

            if reset = '1' then

                contador <= 0;

            elsif contador = 49999999 then

                contador <= 0;

            else

                contador <= contador + 1;

            end if;

        end if;

    end process;



"contador 35"

library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;


entity contador_35 is

    port(
        clk      : in  std_logic;
        reset    : in  std_logic;
        enable   : in  std_logic;
        pulso_1s : in  std_logic;

        fin_35   : out std_logic
    );

end contador_35;


architecture behavioral of contador_35 is

    signal contador : integer range 0 to 35 := 0;

begin

    process(clk)

    begin

        if rising_edge(clk) then

            if reset = '1' then

                contador <= 0;

            elsif enable = '1' and pulso_1s = '1' then

                if contador < 35 then

                    contador <= contador + 1;

                end if;

            end if;

        end if;

    end process;


    fin_35 <= '1' when contador = 35 else '0';

end behavioral;
    pulso_1s <= '1' when contador = 49999999 else '0';

end behavioral;



