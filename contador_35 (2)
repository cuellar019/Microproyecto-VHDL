--divisor_1s
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;


--divisor 50mhz a 1s

entity divisor_1s is
    port(
        clk      : in std_logic;
        reset    : in std_logic;
        pulso_1s : out std_logic
    );
end divisor_1s;


architecture behavioral of divisor_1s is

    signal contador : integer range 0 to 49999999 := 0;

begin


    process(clk)
    begin

        if rising_edge(clk) then

            if reset = '1' then

                contador <= 0;

            elsif contador = 49999999 then

                contador <= 0;

            else

                contador <= contador + 1;

            end if;

        end if;

    end process;


    pulso_1s <= '1'
        when contador = 49999999
        else '0';


end behavioral;

--contador_35s

  library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;


--contador 35s

entity contador35 is
    port(
        clk      : in std_logic;
        reset    : in std_logic;
        enable   : in std_logic;
        pulso_1s : in std_logic;
        fin_35   : out std_logic;
        tiempo   : out integer range 0 to 35
    );
end contador35;


architecture behavioral of contador35 is

    signal contador : integer range 0 to 35 := 0;

begin


    process(clk)
    begin

        if rising_edge(clk) then
            if reset = '1' then

                contador <= 0;

            elsif enable = '1' and pulso_1s = '1' then
                if contador < 35 then

                    contador <= contador + 1;

                end if;

            end if;

        end if;

    end process;


    --tiempo regla

    fin_35 <= '1'
        when contador = 35
        else '0';

    tiempo <= contador;


end behavioral;

